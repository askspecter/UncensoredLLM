# Privy — https://dashboard.privy.io → your app → Settings → Basic
NEXT_PUBLIC_PRIVY_APP_ID=

# Postgres connection string (Neon / Supabase / any Postgres). Migrations run automatically on `npm run build`.
DATABASE_URL=

# "test" settles orders instantly without payment — for testing only, never with a live gateway.
PAYMENTS_MODE=

# Local development only (ignored in production builds): sign in as a fake user without Privy.
# DEV_AUTH_BYPASS=1
# NEXT_PUBLIC_DEV_USER=did:privy:dev


# USDG on Robinhood Chain — your treasury wallet address (receives payments)
NEXT_PUBLIC_PAYMENT_ADDRESS=
# Optional: dedicated RPC (the public one is rate-limited)
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Whop (card checkout) — whop.com/dashboard → Developer
WHOP_API_KEY=
# WHOP_COMPANY_ID=   # optional; the account is resolved from the API key
WHOP_WEBHOOK_SECRET=
# SITE_URL=https://usebeeper.io   # optional; defaults to the request origin for redirect URLs

# AI gateway — https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# ZDR_ONLY=1   # only route to zero-data-retention providers (fewer models/providers available)

# Comma-separated Privy user ids allowed to open /admin (seller payouts). Your id is shown at the bottom of /dashboard.
ADMIN_USER_IDS=


# Venice API — uncensored image generation (https://venice.ai/settings/api)
VENICE_API_KEY=

# bCREDIT holder rewards. Vercel Cron calls /api/cron/bcredit daily with this secret.
CRON_SECRET=
# BCREDIT_SHARE=0.2        # share of daily gross margin paid to $BEEP holders (max 0.5)
# BCREDIT_MIN_BEEP=1000    # minimum $BEEP per account to earn

# BeeperHook (contracts/): once deployed, USDG hook fees are added to the daily bCREDIT pool.
BEEPER_HOOK=
BEEPER_HOOK_FROM_BLOCK=
# Set automatically from /admin/hook; these env vars are only a fallback.

# Server wallet (private key, 0x…): settles x402 USDG payments, signs Proof of Bill receipts and writes the
# daily root on Robinhood Chain. Keep a little ETH on it for gas; it never holds customer funds.
SERVER_WALLET_KEY=

# Orbio upstream: route models Orbio serves at or below OpenRouter's price through Orbio (paid from the server
# wallet's Orbio balance, restocked at /admin/orbio). Falls back to OpenRouter on any error.
ORBIO_UPSTREAM=
