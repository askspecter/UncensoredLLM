# Privy — https://dashboard.privy.io → your app → Settings → Basic
NEXT_PUBLIC_PRIVY_APP_ID=

# Postgres connection string (Neon / Supabase / any Postgres). Migrations run automatically on `npm run build`.
DATABASE_URL=

# "test" settles orders instantly without payment — for testing only, never with a live gateway.
PAYMENTS_MODE=

# Local development only (ignored in production builds): sign in as a fake user without Privy.
# DEV_AUTH_BYPASS=1
# NEXT_PUBLIC_DEV_USER=did:privy:dev

# NOWPayments (crypto checkout) — https://account.nowpayments.io → Settings → Payments → API keys / IPN secret
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# NOWPAYMENTS_SANDBOX=1   # use api-sandbox.nowpayments.io with a sandbox account
# SITE_URL=https://your-domain.com   # optional; defaults to the request origin for IPN/success URLs
